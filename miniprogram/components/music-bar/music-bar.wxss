.bar { position: fixed; left: 24rpx; right: 24rpx; bottom: 24rpx; background: rgba(23,23,23,.96); border: 1rpx solid rgba(255,255,255,.08); border-radius: 28rpx; overflow: hidden; z-index: 50; box-shadow: 0 16rpx 48rpx rgba(0,0,0,.55); }
.prog { height: 8rpx; background: #2b2b2b; }
.fill { height: 100%; background: linear-gradient(90deg, #8b5cf6, #3b82f6, #8b5cf6); border-radius: 0 4rpx 4rpx 0; box-shadow: 0 0 12rpx rgba(139,92,246,.7); }
.main { display: flex; align-items: center; padding: 16rpx 20rpx; gap: 16rpx; }
.cover { width: 88rpx; height: 88rpx; border-radius: 20rpx; background: #1f1f1f; border: 1rpx solid #333; display: flex; align-items: center; justify-content: center; font-size: 44rpx; flex-shrink: 0; }
.meta { flex: 1; min-width: 0; overflow: hidden; }
.t { color: #fff; font-size: 28rpx; font-weight: bold; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.s { color: #737373; font-size: 22rpx; margin-top: 4rpx; letter-spacing: 2rpx; }
.time { font-size: 22rpx; color: #737373; flex-shrink: 0; }
.cbtn { font-size: 34rpx; color: #a3a3a3; padding: 8rpx; flex-shrink: 0; }
.play { width: 88rpx; height: 88rpx; border-radius: 50%; background: #fff; color: #000; font-size: 32rpx; display: flex; align-items: center; justify-content: center; box-shadow: 0 8rpx 20rpx rgba(0,0,0,.4); flex-shrink: 0; }
/* 浅色 */
.bar.light { background: rgba(255,255,255,.97); border-color: #e5e5e5; }
.bar.light .prog { background: #eee; }
.bar.light .cover { background: #f0f0f0; border-color: #e0e0e0; }
.bar.light .t { color: #111; }
.bar.light .s, .bar.light .time { color: #888; }
.bar.light .cbtn { color: #555; }
.bar.light .play { background: #111; color: #fff; }
/* 紫色 */
.bar.purple { background: rgba(33,23,54,.96); border-color: #3a2b5c; }
.bar.purple .prog { background: #3a2b5c; }
.bar.purple .cover { background: #241a3d; border-color: #3a2b5c; }
.bar.purple .t { color: #f3efff; }
.bar.purple .s, .bar.purple .time { color: #b7a8d9; }
.bar.purple .cbtn { color: #cfc2ee; }
/* 蓝色 */
.bar.blue { background: rgba(16,32,47,.96); border-color: #1e3a52; }
.bar.blue .prog { background: #1e3a52; }
.bar.blue .cover { background: #13293d; border-color: #1e3a52; }
.bar.blue .t { color: #eef6ff; }
.bar.blue .s, .bar.blue .time { color: #93b4cc; }
.bar.blue .cbtn { color: #b9d2e6; }
/* 绿色 */
.bar.green { background: rgba(16,36,27,.96); border-color: #1e4d3a; }
.bar.green .prog { background: #1e4d3a; }
.bar.green .cover { background: #143026; border-color: #1e4d3a; }
.bar.green .t { color: #effff6; }
.bar.green .s, .bar.green .time { color: #93c4ab; }
.bar.green .cbtn { color: #b5d9c6; }
