.lrcline.cur.lrc-c25 { color: #f5d0fe; text-shadow: 0 0 20rpx #f5d0fe; }
.lrcline.cur.lrc-c26 { color: #2563eb; text-shadow: 0 0 20rpx #2563eb; }
.lrcline.cur.lrc-c27 { color: #059669; text-shadow: 0 0 20rpx #059669; }
.lrcline.cur.lrc-c28 { color: #d97706; text-shadow: 0 0 20rpx #d97706; }
.lrcline.cur.lrc-c29 { color: #4f46e5; text-shadow: 0 0 20rpx #4f46e5; }
/* 浅色 */
.page.light { background: radial-gradient(120% 50% at 50% 0%, #fff 0%, #f5f5f5 60%); }
.page.light .sec-title, .page.light .song { color: #111; }
.page.light .tip, .page.light .artist, .page.light .time-row { color: #666; }
.page.light .status { background: #fff; border-color: #e5e5e5; }
.page.light .vinyl { border-color: #e5e5e5; box-shadow: 0 24rpx 60rpx rgba(0,0,0,.12); }
.page.light .panel { background: rgba(255,255,255,.78); border-color: rgba(17,17,17,.07); box-shadow: 0 8rpx 28rpx rgba(0,0,0,.08), inset 0 1rpx 0 rgba(255,255,255,.7); }
.page.light .cbtn { background: rgba(238,238,238,.9); border-color: rgba(17,17,17,.06); box-shadow: 0 8rpx 20rpx rgba(0,0,0,.1), inset 0 1rpx 0 rgba(255,255,255,.7); }
.page.light .bar { background: #eee; }
.page.light .bar-fill { background: linear-gradient(90deg, #7c3aed, #db2777); }
.page.light .disc-fallback { background: linear-gradient(135deg, #e5e5e5, #fff); }
.page.light .row, .page.light .qitem, .page.light .rowhead { color: #333; }
.page.light .qitem:active { background: #f0f0f0; }
.page.light .qitem.cur { background: rgba(124,58,237,.08); }
.page.light .cbtn { background: #eee; color: #111; }
.page.light .cbtn:active { background: #ddd; }
.page.light .cbtn.big { background: linear-gradient(135deg, #111, #333); color: #fff; }
.page.light .eqv, .page.light .eqk { color: #333; }
.page.light .lb { color: #666; }
.page.light .picker { background: rgba(255,255,255,.8); border-color: #ddd; color: #111; box-shadow: inset 0 2rpx 6rpx rgba(0,0,0,.06); }
.page.light .lrcline { color: #999; }
.page.light .badge { color: #7c3aed; border-color: #ddd; background: rgba(124,58,237,.06); }
/* 紫色 */
.page.purple { background: radial-gradient(120% 50% at 50% 0%, #2a1b4d 0%, #150f22 60%); }
.page.purple .sec-title, .page.purple .song, .page.purple .rowhead { color: #f3efff; }
.page.purple .tip, .page.purple .artist, .page.purple .time-row { color: #b7a8d9; }
.page.purple .status { background: #211736; border-color: #6d28d9; color: #cfc2ee; }
.page.purple .vinyl { border-color: #6d28d9; }
.page.purple .ring { background: conic-gradient(from 0deg, #c4b5fd, #8b5cf6, #6d28d9, #c4b5fd); opacity: .8; }
.page.purple .disc-fallback { background: linear-gradient(135deg, #3a2b5c, #211736); }
.page.purple .panel { background: rgba(33,23,54,.78); border-color: rgba(196,181,253,.18); box-shadow: 0 12rpx 40rpx rgba(0,0,0,.4), inset 0 1rpx 0 rgba(196,181,253,.12); }
.page.purple .cbtn { background: rgba(58,43,92,.85); border-color: rgba(196,181,253,.18); }
.page.purple .bar { background: #3a2b5c; }
.page.purple .bar-fill { background: linear-gradient(90deg, #c4b5fd, #8b5cf6); }
.page.purple .cbtn { background: #3a2b5c; color: #e9e2ff; }
.page.purple .cbtn:active { background: #4c3a75; }
.page.purple .cbtn.big { background: linear-gradient(135deg, #a78bfa, #7c3aed); color: #fff; box-shadow: 0 12rpx 32rpx rgba(124,58,237,.5); }
.page.purple .qitem { color: #cfc2ee; border-color: #3a2b5c; }
.page.purple .qitem:active { background: #3a2b5c; }
.page.purple .qitem.cur { color: #fff; background: rgba(139,92,246,.22); }
.page.purple .row { color: #e9e2ff; }
.page.purple .badge { color: #e9e2ff; border-color: #6d28d9; background: rgba(139,92,246,.18); }
.page.purple .eqk, .page.purple .eqv { color: #cfc2ee; }
.page.purple .lb { color: #b7a8d9; }
.page.purple .picker { background: rgba(33,23,54,.7); border-color: #3a2b5c; color: #f3efff; }
.page.purple .lrcline { color: #8d7bb5; }
/* 蓝色 */
.page.blue { background: radial-gradient(120% 50% at 50% 0%, #123049 0%, #0a141f 60%); }
.page.blue .sec-title, .page.blue .song, .page.blue .rowhead { color: #eef6ff; }
.page.blue .tip, .page.blue .artist, .page.blue .time-row { color: #93b4cc; }
.page.blue .status { background: #10202f; border-color: #0284c7; color: #b9d2e6; }
.page.blue .vinyl { border-color: #0284c7; }
.page.blue .ring { background: conic-gradient(from 0deg, #7dd3fc, #38bdf8, #0284c7, #7dd3fc); opacity: .8; }
.page.blue .disc-fallback { background: linear-gradient(135deg, #1e3a52, #10202f); }
.page.blue .panel { background: rgba(16,32,47,.78); border-color: rgba(125,211,252,.18); box-shadow: 0 12rpx 40rpx rgba(0,0,0,.4), inset 0 1rpx 0 rgba(125,211,252,.12); }
.page.blue .cbtn { background: rgba(30,58,82,.85); border-color: rgba(125,211,252,.18); }
.page.blue .bar { background: #1e3a52; }
.page.blue .bar-fill { background: linear-gradient(90deg, #7dd3fc, #0284c7); }
.page.blue .cbtn { background: #1e3a52; color: #dcedff; }
.page.blue .cbtn:active { background: #2a4f6e; }
.page.blue .cbtn.big { background: linear-gradient(135deg, #38bdf8, #0284c7); color: #fff; box-shadow: 0 12rpx 32rpx rgba(2,132,199,.5); }
.page.blue .qitem { color: #b9d2e6; border-color: #1e3a52; }
.page.blue .qitem:active { background: #1e3a52; }
.page.blue .qitem.cur { color: #fff; background: rgba(56,189,248,.18); }
.page.blue .row { color: #dcedff; }
.page.blue .badge { color: #b9e4ff; border-color: #0284c7; background: rgba(56,189,248,.14); }
.page.blue .eqk, .page.blue .eqv { color: #b9d2e6; }
.page.blue .lb { color: #93b4cc; }
.page.blue .picker { background: rgba(16,32,47,.7); border-color: #1e3a52; color: #eef6ff; }
.page.blue .lrcline { color: #6b8ba3; }
/* 绿色 */
.page.green { background: radial-gradient(120% 50% at 50% 0%, #143527 0%, #0a1512 60%); }
.page.green .sec-title, .page.green .song, .page.green .rowhead { color: #effff6; }
.page.green .tip, .page.green .artist, .page.green .time-row { color: #93c4ab; }
.page.green .status { background: #10241b; border-color: #059669; color: #b5d9c6; }
.page.green .vinyl { border-color: #059669; }
.page.green .ring { background: conic-gradient(from 0deg, #6ee7b7, #34d399, #059669, #6ee7b7); opacity: .8; }
.page.green .disc-fallback { background: linear-gradient(135deg, #1e4d3a, #10241b); }
.page.green .panel { background: rgba(16,36,27,.78); border-color: rgba(110,231,183,.18); box-shadow: 0 12rpx 40rpx rgba(0,0,0,.4), inset 0 1rpx 0 rgba(110,231,183,.12); }
.page.green .cbtn { background: rgba(30,77,58,.85); border-color: rgba(110,231,183,.18); }
.page.green .bar { background: #1e4d3a; }
.page.green .bar-fill { background: linear-gradient(90deg, #6ee7b7, #059669); }
.page.green .cbtn { background: #1e4d3a; color: #dcffec; }
.page.green .cbtn:active { background: #2a654e; }
.page.green .cbtn.big { background: linear-gradient(135deg, #34d399, #059669); color: #fff; box-shadow: 0 12rpx 32rpx rgba(5,150,105,.5); }
.page.green .qitem { color: #b5d9c6; border-color: #1e4d3a; }
.page.green .qitem:active { background: #1e4d3a; }
.page.green .qitem.cur { color: #fff; background: rgba(52,211,153,.18); }
.page.green .row { color: #dcffec; }
.page.green .badge { color: #b8f5d6; border-color: #059669; background: rgba(52,211,153,.14); }
.page.green .eqk, .page.green .eqv { color: #b5d9c6; }
.page.green .lb { color: #93c4ab; }
.page.green .picker { background: rgba(16,36,27,.7); border-color: #1e4d3a; color: #effff6; }
/* 图标显色：显式颜色（currentColor/inherit 在此环境失效） */
.cbtn .ic-play { border-left-color: #fff; }
.cbtn .ic-pause::before, .cbtn .ic-pause::after { background-color: #fff; }
.cbtn .ic-prev::before, .cbtn .ic-next::after { background-color: #fff; }
.cbtn .ic-prev::after { border-right-color: #fff; }
.cbtn .ic-next::before { border-left-color: #fff; }
.cbtn.big .ic-play { border-left-color: #000; }
.cbtn.big .ic-pause::before, .cbtn.big .ic-pause::after { background-color: #000; }
.page.light .cbtn .ic-play { border-left-color: #111; }
.page.light .cbtn .ic-pause::before, .page.light .cbtn .ic-pause::after { background-color: #111; }
.page.light .cbtn .ic-prev::before, .page.light .cbtn .ic-next::after { background-color: #111; }
.page.light .cbtn .ic-prev::after { border-right-color: #111; }
.page.light .cbtn .ic-next::before { border-left-color: #111; }
.page.light .cbtn.big .ic-play { border-left-color: #fff; }
.page.light .cbtn.big .ic-pause::before, .page.light .cbtn.big .ic-pause::after { background-color: #fff; }
.page.purple .cbtn .ic-play { border-left-color: #e9e2ff; }
.page.purple .cbtn .ic-pause::before, .page.purple .cbtn .ic-pause::after { background-color: #e9e2ff; }
.page.purple .cbtn .ic-prev::before, .page.purple .cbtn .ic-next::after { background-color: #e9e2ff; }
.page.purple .cbtn .ic-prev::after { border-right-color: #e9e2ff; }
.page.purple .cbtn .ic-next::before { border-left-color: #e9e2ff; }
.page.purple .cbtn.big .ic-play { border-left-color: #fff; }
