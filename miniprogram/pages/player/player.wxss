.page { min-height: 100vh; background: radial-gradient(90% 40% at 80% 0%, rgba(139,92,246,.12) 0%, transparent 60%), radial-gradient(120% 50% at 50% 0%, #1c1c1e 0%, #0a0a0a 55%); padding: 32rpx; padding-bottom: 60rpx; }
.nav { display: flex; align-items: center; justify-content: space-between; }
.sec-title { color: #fff; font-size: 38rpx; font-weight: 900; margin-bottom: 8rpx; }
.status { display: flex; align-items: center; gap: 8rpx; font-size: 24rpx; color: #737373; background: #171717; border: 1rpx solid #262626; border-radius: 999rpx; padding: 8rpx 20rpx; }
.status .dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #525252; }
.status.on { color: #4ade80; border-color: rgba(74,222,128,.35); }
.status.on .dot { background: #22c55e; box-shadow: 0 0 8rpx rgba(34,197,94,.9); animation: blink 1.6s ease-in-out infinite; }
@keyframes blink { 0%,100% { opacity: 1; } 50% { opacity: .35; } }
.tip { color: #737373; font-size: 26rpx; margin-bottom: 16rpx; }
/* 唱片区 */
.hero { display: flex; flex-direction: column; align-items: center; margin: 16rpx 0 24rpx; }
/* 封面/歌词同区互换（对标 admin disc 区原地切换） */
.stage { height: 560rpx; display: flex; align-items: center; justify-content: center; width: 100%; }
.vinyl { width: 420rpx; height: 420rpx; border-radius: 50%; position: relative; background: radial-gradient(circle, #262626 0%, #111 62%, #000 100%); border: 1rpx solid #333; box-shadow: 0 24rpx 80rpx rgba(0,0,0,.6), 0 0 0 12rpx rgba(255,255,255,.03); display: flex; align-items: center; justify-content: center; }
.vinyl.spin { animation: spin 8s linear infinite; }
@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
.ring { position: absolute; inset: -14rpx; border-radius: 50%; background: conic-gradient(from 0deg, #8b5cf6, #3b82f6, #22c55e, #f59e0b, #8b5cf6); opacity: .55; filter: blur(18rpx); z-index: -1; }
/* 黑胶封面：有图时整盘就是封面（对标 admin music 页转盘），随 vinyl 一起旋转 */
.disc-art { position: absolute; inset: 0; width: 100%; height: 100%; border-radius: 50%; }
.disc-fallback { position: absolute; inset: 0; border-radius: 50%; background: linear-gradient(135deg, #2b2b2b, #111); display: flex; align-items: center; justify-content: center; font-size: 120rpx; }
.grooves { position: absolute; inset: 0; border-radius: 50%; background: repeating-radial-gradient(circle, transparent 0 8rpx, rgba(255,255,255,.06) 8rpx 9rpx); pointer-events: none; }
/* 中心孔（对标 admin disc 中心孔，随盘同转，居中故无视觉位移） */
.disc-hole { position: absolute; left: 50%; top: 50%; width: 96rpx; height: 96rpx; margin: -48rpx 0 0 -48rpx; border-radius: 50%; background: #0a0a0a; border: 4rpx solid #333; display: flex; align-items: center; justify-content: center; z-index: 2; }
.hole-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #525252; }
.song { color: #fff; font-size: 44rpx; font-weight: 900; letter-spacing: -1rpx; margin-top: 24rpx; text-align: center; }
.artist { color: #a3a3a3; font-size: 28rpx; letter-spacing: 2rpx; margin-top: 10rpx; text-align: center; }
.badges { margin-top: 16rpx; display: flex; gap: 12rpx; justify-content: center; }
.badge { color: #c4b5fd; border: 1rpx solid #4c1d95; background: rgba(124,58,237,.12); border-radius: 999rpx; padding: 6rpx 18rpx; font-size: 24rpx; }
/* 面板：玻璃拟态（底色半透明 + 毛玻璃见 app.wxss .glass） */
.panel { background: rgba(23,23,23,.78); border: 1rpx solid rgba(255,255,255,.09); border-radius: 28rpx; padding: 28rpx; margin-bottom: 20rpx; box-shadow: 0 12rpx 40rpx rgba(0,0,0,.4), inset 0 1rpx 0 rgba(255,255,255,.06); }
.progress-panel { padding-top: 20rpx; }
/* 进度条点播区：加大触摸面积，视觉条保持纤细 */
.barzone { padding: 24rpx 4rpx; margin: 0 -4rpx; }
.bar { height: 12rpx; border-radius: 999rpx; background: #2b2b2b; position: relative; box-shadow: inset 0 1rpx 4rpx rgba(0,0,0,.5); }
.bar-fill { height: 100%; border-radius: 999rpx; background: linear-gradient(90deg, #8b5cf6, #3b82f6); box-shadow: 0 0 12rpx rgba(139,92,246,.8); transition: width .5s linear; }
.bar-dot { position: absolute; top: 50%; width: 24rpx; height: 24rpx; border-radius: 50%; background: #fff; transform: translate(-50%,-50%); box-shadow: 0 0 12rpx rgba(255,255,255,.9), 0 2rpx 8rpx rgba(0,0,0,.5); }
.sl { width: 100%; }
.time-row { display: flex; justify-content: space-between; color: #737373; font-size: 24rpx; margin-top: 4rpx; font-variant-numeric: tabular-nums; }
.ctrls { display: flex; justify-content: center; align-items: center; gap: 28rpx; margin-top: 20rpx; }
.ctrls.sub { gap: 16rpx; }
.cbtn { width: 104rpx; height: 104rpx; border-radius: 50%; background: rgba(38,38,38,.85); border: 1rpx solid rgba(255,255,255,.09); color: #fff; display: flex; align-items: center; justify-content: center; box-shadow: 0 8rpx 24rpx rgba(0,0,0,.4), inset 0 1rpx 0 rgba(255,255,255,.08); transition: transform .15s ease, opacity .15s ease, background-color .15s ease, box-shadow .15s ease; }
.cbtn:active { background: #3a3a3a; }
/* 矢量图标随按钮走：两侧小，大键更大，flex 下天然居中 */
.ctrls .cbtn .ic { font-size: 36rpx; }
.cbtn.big { width: 156rpx; height: 156rpx; background: linear-gradient(135deg, #fff, #d4d4d4); border-color: rgba(255,255,255,.4); color: #000; box-shadow: 0 12rpx 32rpx rgba(255,255,255,.16), inset 0 2rpx 0 rgba(255,255,255,.6); }
.cbtn.big .ic { font-size: 56rpx; }
.cbtn.big:active { box-shadow: 0 6rpx 16rpx rgba(255,255,255,.15); }
.cbtn.sm { height: 72rpx; border-radius: 999rpx; font-size: 26rpx; padding: 0 28rpx; }
/* 模式/队列胶囊按内容自适应（定宽 104rpx 会把字挤爆）；音量步进键保持定宽 */
.ctrls.sub .cbtn.sm { width: auto; white-space: nowrap; }
.cbtn.stepper { border-radius: 50%; min-width: 72rpx; height: 72rpx; padding: 0; font-size: 40rpx; }
.row { display: flex; align-items: center; color: #e5e5e5; font-size: 28rpx; gap: 16rpx; }
.rowhead { display: flex; justify-content: space-between; align-items: center; color: #fff; font-size: 28rpx; font-weight: bold; margin-bottom: 8rpx; }
.count { color: #737373; font-weight: normal; font-size: 24rpx; }
.flex1 { flex: 1; }
.qitem { color: #d4d4d4; font-size: 28rpx; padding: 20rpx 16rpx; border-bottom: 1rpx solid #1f1f1f; display: flex; justify-content: space-between; align-items: center; gap: 16rpx; border-radius: 16rpx; transition: transform .15s ease, opacity .15s ease, background-color .15s ease; }
.qitem:active { background: #262626; }
.qitem.cur { color: #a78bfa; font-weight: bold; background: rgba(124,58,237,.1); }
.qn { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.qa { color: #737373; font-size: 24rpx; flex-shrink: 0; max-width: 220rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
/* 队列定高内滚（对标 admin max-h 400px），长队列不再撑爆页面 */
.qlist { max-height: 560rpx; }
.eqrow { display: flex; align-items: center; gap: 16rpx; margin-top: 12rpx; }
.eqk { color: #a3a3a3; font-size: 24rpx; width: 110rpx; }
.eqv { color: #fff; font-size: 24rpx; width: 60rpx; text-align: right; font-variant-numeric: tabular-nums; }
/* 预设下拉 */
.lb { color: #a3a3a3; font-size: 24rpx; margin: 12rpx 0 8rpx; }
.picker { background: rgba(23,23,23,.7); border: 1rpx solid rgba(255,255,255,.1); border-radius: 12rpx; color: #fff; padding: 16rpx; font-size: 28rpx; box-shadow: inset 0 2rpx 8rpx rgba(0,0,0,.4); }
/* 歌词：scroll-view 定高内部滚，当前行高亮（对标 admin music 页） */
.lyric-tip { margin-top: 16rpx; margin-bottom: 0; text-align: center; }
.lrcbox { height: 100%; width: 100%; padding: 56rpx 0; box-sizing: border-box; }
.lrcline { text-align: center; color: #737373; font-size: 28rpx; font-weight: bold; line-height: 64rpx; padding: 0 16rpx; }
.lrcline.cur { font-size: 34rpx; font-weight: 900; }
/* 当前行 30 色轮换 + 同色发光（对标 admin gradients/shadowColors，纯色保渲染） */
.lrcline.cur.lrc-c0 { color: #fb7185; text-shadow: 0 0 20rpx #fb7185; }
.lrcline.cur.lrc-c1 { color: #38bdf8; text-shadow: 0 0 20rpx #38bdf8; }
.lrcline.cur.lrc-c2 { color: #fbbf24; text-shadow: 0 0 20rpx #fbbf24; }
