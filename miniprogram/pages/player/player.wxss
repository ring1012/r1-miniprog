.lrcline.cur.lrc-c12 { color: #f43f5e; text-shadow: 0 0 20rpx #f43f5e; }
.lrcline.cur.lrc-c13 { color: #60a5fa; text-shadow: 0 0 20rpx #60a5fa; }
.lrcline.cur.lrc-c14 { color: #fb923c; text-shadow: 0 0 20rpx #fb923c; }
.lrcline.cur.lrc-c15 { color: #c084fc; text-shadow: 0 0 20rpx #c084fc; }
.lrcline.cur.lrc-c16 { color: #4ade80; text-shadow: 0 0 20rpx #4ade80; }
.lrcline.cur.lrc-c17 { color: #06b6d4; text-shadow: 0 0 20rpx #06b6d4; }
.lrcline.cur.lrc-c18 { color: #f472b6; text-shadow: 0 0 20rpx #f472b6; }
.lrcline.cur.lrc-c19 { color: #10b981; text-shadow: 0 0 20rpx #10b981; }
.lrcline.cur.lrc-c20 { color: #8b5cf6; text-shadow: 0 0 20rpx #8b5cf6; }
.lrcline.cur.lrc-c21 { color: #f59e0b; text-shadow: 0 0 20rpx #f59e0b; }
.lrcline.cur.lrc-c22 { color: #fda4af; text-shadow: 0 0 20rpx #fda4af; }
.lrcline.cur.lrc-c23 { color: #a7f3d0; text-shadow: 0 0 20rpx #a7f3d0; }
