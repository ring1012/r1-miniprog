.page { min-height: 100vh; background: radial-gradient(100% 45% at 50% 0%, #161618 0%, #0a0a0a 55%); padding: 32rpx; padding-bottom: 170rpx; }
.sec-title { color: #fff; font-size: 38rpx; font-weight: 900; margin-bottom: 8rpx; }
.tip { color: #737373; font-size: 26rpx; margin-bottom: 16rpx; }
.card { background: rgba(23,23,23,.75); -webkit-backdrop-filter: blur(24rpx); backdrop-filter: blur(24rpx); border: 1rpx solid rgba(255,255,255,.09); border-radius: 24rpx; padding: 28rpx; margin-bottom: 20rpx; box-shadow: 0 12rpx 36rpx rgba(0,0,0,.4), inset 0 1rpx 0 rgba(255,255,255,.06); }
.card-title { color: #fff; font-size: 32rpx; font-weight: bold; margin-bottom: 8rpx; }
.card-desc { color: #737373; font-size: 24rpx; margin-bottom: 12rpx; }
.lb { color: #a3a3a3; font-size: 24rpx; margin: 16rpx 0 8rpx; }
.in { background: rgba(10,10,10,.6); border: 1rpx solid rgba(255,255,255,.1); border-radius: 12rpx; color: #fff; padding: 0 16rpx; height: 88rpx; line-height: 88rpx; font-size: 28rpx; width: 100%; box-sizing: border-box; box-shadow: inset 0 2rpx 8rpx rgba(0,0,0,.4); }
.picker { background: rgba(10,10,10,.6); border: 1rpx solid rgba(255,255,255,.1); border-radius: 12rpx; color: #fff; padding: 16rpx; font-size: 28rpx; box-shadow: inset 0 2rpx 8rpx rgba(0,0,0,.4); }
.presets { display: flex; flex-wrap: wrap; margin-top: 12rpx; }
.preset { color: #7dd3fc; font-size: 24rpx; border: 1rpx solid rgba(125,211,252,.3); border-radius: 20rpx; padding: 6rpx 16rpx; margin: 0 12rpx 12rpx 0; }
.guide { color: #737373; font-size: 24rpx; margin-top: 12rpx; }
.btn { color: #fff; border-radius: 16rpx; margin-top: 16rpx; font-size: 28rpx; box-shadow: 0 8rpx 24rpx rgba(139,92,246,.35), inset 0 1rpx 0 rgba(255,255,255,.25); background: linear-gradient(135deg, #8b5cf6, #7c3aed); }
.btn.sky { background: linear-gradient(135deg, #38bdf8, #0284c7); box-shadow: 0 8rpx 24rpx rgba(2,132,199,.35), inset 0 1rpx 0 rgba(255,255,255,.25); }
.btn.violet { background: linear-gradient(135deg, #8b5cf6, #7c3aed); }
.btn.amber { background: linear-gradient(135deg, #f59e0b, #d97706); box-shadow: 0 8rpx 24rpx rgba(217,119,6,.35), inset 0 1rpx 0 rgba(255,255,255,.25); }
.btn.green { background: linear-gradient(135deg, #34d399, #059669); box-shadow: 0 8rpx 24rpx rgba(5,150,105,.35), inset 0 1rpx 0 rgba(255,255,255,.25); }
.page.light { background: radial-gradient(100% 45% at 50% 0%, #ffffff 0%, #edf0f4 55%); }
.page.light .sec-title, .page.light .card-title { color: #111; }
.page.light .tip, .page.light .card-desc, .page.light .guide { color: #666; }
.page.light .lb { color: #666; }
.page.light .card { background: rgba(255,255,255,.8); border-color: rgba(17,17,17,.07); box-shadow: 0 8rpx 28rpx rgba(0,0,0,.08), inset 0 1rpx 0 rgba(255,255,255,.7); }
.page.light .in, .page.light .picker { background: rgba(245,245,245,.7); border-color: #ddd; color: #111; box-shadow: inset 0 2rpx 6rpx rgba(0,0,0,.06); }
/* 触摸反馈 */
.card, .btn, .preset { transition: transform .15s ease, opacity .15s ease, background-color .15s ease; }
.btn:active { transform: scale(.97); opacity: .9; filter: brightness(1.08); }
.preset:active { transform: scale(.95); opacity: .8; }
/* 紫色 */
.page.purple { background: radial-gradient(100% 45% at 50% 0%, #2a1a48 0%, #150f22 55%); }
.page.purple .sec-title, .page.purple .card-title { color: #f3efff; }
.page.purple .tip, .page.purple .card-desc, .page.purple .guide { color: #b7a8d9; }
.page.purple .lb { color: #b7a8d9; }
.page.purple .card { background: rgba(33,23,54,.75); border-color: rgba(196,181,253,.16); box-shadow: 0 12rpx 36rpx rgba(0,0,0,.4), inset 0 1rpx 0 rgba(196,181,253,.12); }
.page.purple .in, .page.purple .picker { background: rgba(21,15,34,.6); border-color: #3a2b5c; color: #f3efff; }
/* 蓝色 */
.page.blue { background: radial-gradient(100% 45% at 50% 0%, #122c44 0%, #0a141f 55%); }
.page.blue .sec-title, .page.blue .card-title { color: #eef6ff; }
.page.blue .tip, .page.blue .card-desc, .page.blue .guide { color: #93b4cc; }
.page.blue .lb { color: #93b4cc; }
.page.blue .card { background: rgba(16,32,47,.75); border-color: rgba(125,211,252,.16); box-shadow: 0 12rpx 36rpx rgba(0,0,0,.4), inset 0 1rpx 0 rgba(125,211,252,.12); }
.page.blue .in, .page.blue .picker { background: rgba(10,20,31,.6); border-color: #1e3a52; color: #eef6ff; }
/* 绿色 */
.page.green { background: radial-gradient(100% 45% at 50% 0%, #122c20 0%, #0a1512 55%); }
.page.green .sec-title, .page.green .card-title { color: #effff6; }
.page.green .tip, .page.green .card-desc, .page.green .guide { color: #93c4ab; }
.page.green .lb { color: #93c4ab; }
.page.green .card { background: rgba(16,36,27,.75); border-color: rgba(110,231,183,.16); box-shadow: 0 12rpx 36rpx rgba(0,0,0,.4), inset 0 1rpx 0 rgba(110,231,183,.12); }
.page.green .in, .page.green .picker { background: rgba(10,21,18,.6); border-color: #1e4d3a; color: #effff6; }
