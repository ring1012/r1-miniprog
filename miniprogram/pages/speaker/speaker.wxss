.page { min-height: 100vh; background: #0a0a0a; padding: 32rpx; padding-bottom: 170rpx; }
.topbar { display: flex; justify-content: space-between; align-items: center; }
.left { display: flex; align-items: center; gap: 16rpx; }
.menubtn { font-size: 44rpx; color: #e5e5e5; padding: 8rpx; }
.drawer-mask { position: fixed; inset: 0; background: rgba(0,0,0,.5); z-index: 98; }
.drawer { position: fixed; left: 0; top: 0; bottom: 0; width: 560rpx; background: #141414; z-index: 99; transform: translateX(-105%); transition: transform .28s ease; padding-top: 24rpx; }
.drawer.open { transform: translateX(0); }
.drawer-head { display: flex; align-items: center; gap: 16rpx; padding: 24rpx 28rpx; border-bottom: 1rpx solid #262626; margin-bottom: 12rpx; }
.drawer-title { color: #fff; font-size: 32rpx; font-weight: bold; }
.drawer .menu-item { margin: 4rpx 16rpx; }
.avatar-wrap { position: relative; }
.avatar { width: 72rpx; height: 72rpx; border-radius: 50%; background: #262626; display: flex; align-items: center; justify-content: center; font-size: 40rpx; }
.menu-mask { position: fixed; inset: 0; background: transparent; z-index: 98; }
.menu { position: absolute; right: 0; top: 88rpx; min-width: 264rpx; background: #1c1c1c; border: 1rpx solid #333; border-radius: 20rpx; padding: 12rpx; z-index: 99; white-space: nowrap; }
.menu-item { color: #e5e5e5; font-size: 28rpx; padding: 20rpx 16rpx; border-radius: 12rpx; }
.dev-name { color: #fff; font-size: 34rpx; font-weight: bold; }
.dev-sub { color: #737373; font-size: 24rpx; margin-top: 6rpx; }
.hero { text-align: center; margin: 40rpx 0; }
.hero-title { color: #fff; font-size: 44rpx; font-weight: 900; }
.grad { color: #a78bfa; }
.hero-sub { color: #a3a3a3; font-size: 28rpx; margin-top: 12rpx; }
.cards { display: flex; flex-direction: column; gap: 20rpx; }
.card { background: #171717; border: 1rpx solid #262626; border-radius: 24rpx; padding: 28rpx; }
.card-head { display: flex; align-items: center; gap: 16rpx; }
.card-icon { font-size: 52rpx; }
.card-title { color: #fff; font-size: 38rpx; font-weight: 900; letter-spacing: 4rpx; }
.card-desc { color: #a3a3a3; font-size: 27rpx; line-height: 44rpx; margin-top: 14rpx; }
.sec-title { color: #fff; font-size: 30rpx; font-weight: bold; margin-bottom: 16rpx; }
.tip { color: #737373; font-size: 26rpx; }
.support, .wall { margin-top: 32rpx; }
.qr-row { display: flex; gap: 24rpx; margin-top: 16rpx; }
.qr { flex: 1; width: 0; border-radius: 16rpx; background: #fff; }
.donor { color: #d4d4d4; font-size: 26rpx; padding: 12rpx 0; border-bottom: 1rpx solid #1f1f1f; display: flex; justify-content: space-between; }
/* 浅色主题覆盖 */
.page.light { background: #f5f5f5; }
.page.light .dev-name, .page.light .hero-title, .page.light .card-title, .page.light .sec-title { color: #111; }
.page.light .dev-sub, .page.light .hero-sub, .page.light .card-desc, .page.light .tip { color: #666; }
.page.light .card { background: #fff; border-color: #e5e5e5; }
.page.light .donor { color: #333; border-color: #eee; }
.page.light .avatar { background: #e5e5e5; }
.page.light .menu { background: #fff; border-color: #e5e5e5; }
.page.light .menu-item { color: #333; }
.page.light .menubtn { color: #333; }
.page.light .drawer { background: #fff; }
.page.light .drawer-head { border-color: #eee; }
.page.light .drawer-title { color: #111; }
/* 紫色主题 */
.page.purple { background: #150f22; }
.page.purple .dev-name, .page.purple .hero-title, .page.purple .card-title, .page.purple .sec-title { color: #f3efff; }
.page.purple .dev-sub, .page.purple .hero-sub, .page.purple .card-desc, .page.purple .tip { color: #b7a8d9; }
.page.purple .card { background: #211736; border-color: #3a2b5c; }
.page.purple .donor { color: #cfc2ee; border-color: #3a2b5c; }
.page.purple .avatar { background: #3a2b5c; }
.page.purple .menu { background: #1e1430; border-color: #3a2b5c; }
.page.purple .menu-item { color: #e9e2ff; }
.page.purple .menubtn { color: #e9e2ff; }
.page.purple .drawer { background: #1e1430; }
.page.purple .drawer-head { border-color: #3a2b5c; }
.page.purple .drawer-title { color: #f3efff; }
/* 蓝色主题 */
.page.blue { background: #0a141f; }
.page.blue .dev-name, .page.blue .hero-title, .page.blue .card-title, .page.blue .sec-title { color: #eef6ff; }
.page.blue .dev-sub, .page.blue .hero-sub, .page.blue .card-desc, .page.blue .tip { color: #93b4cc; }
.page.blue .card { background: #10202f; border-color: #1e3a52; }
.page.blue .donor { color: #b9d2e6; border-color: #1e3a52; }
.page.blue .avatar { background: #1e3a52; }
.page.blue .menu { background: #0f1f30; border-color: #1e3a52; }
.page.blue .menu-item { color: #dcedff; }
.page.blue .menubtn { color: #dcedff; }
.page.blue .drawer { background: #0f1f30; }
.page.blue .drawer-head { border-color: #1e3a52; }
.page.blue .drawer-title { color: #eef6ff; }
/* 绿色主题 */
.page.green { background: #0a1512; }
.page.green .dev-name, .page.green .hero-title, .page.green .card-title, .page.green .sec-title { color: #effff6; }
.page.green .dev-sub, .page.green .hero-sub, .page.green .card-desc, .page.green .tip { color: #93c4ab; }
.page.green .card { background: #10241b; border-color: #1e4d3a; }
.page.green .donor { color: #b5d9c6; border-color: #1e4d3a; }
.page.green .avatar { background: #1e4d3a; }
.page.green .menu { background: #0e2118; border-color: #1e4d3a; }
.page.green .menu-item { color: #dcffec; }
.page.green .menubtn { color: #dcffec; }
