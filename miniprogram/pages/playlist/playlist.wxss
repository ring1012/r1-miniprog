.page { min-height: 100vh; background: radial-gradient(100% 45% at 50% 0%, #161618 0%, #0a0a0a 55%); padding: 32rpx; padding-bottom: 170rpx; }
.sec-title { color: #fff; font-size: 38rpx; font-weight: 900; margin-bottom: 8rpx; }
.tip { color: #737373; font-size: 26rpx; margin-bottom: 16rpx; }
.searchbar { display: flex; gap: 16rpx; margin: 16rpx 0 24rpx; }
.sin { flex: 1; background: rgba(23,23,23,.7); border: 1rpx solid rgba(255,255,255,.1); border-radius: 16rpx; color: #fff; padding: 0 18rpx; height: 88rpx; line-height: 88rpx; font-size: 28rpx; box-sizing: border-box; box-shadow: inset 0 2rpx 8rpx rgba(0,0,0,.4); }
.sbtn { background: linear-gradient(135deg, #8b5cf6, #7c3aed); color: #fff; border-radius: 16rpx; font-size: 28rpx; min-width: 160rpx; box-shadow: 0 8rpx 24rpx rgba(139,92,246,.35), inset 0 1rpx 0 rgba(255,255,255,.25); }
.rowhead { color: #fff; font-size: 28rpx; font-weight: bold; display: flex; justify-content: space-between; margin: 12rpx 0; }
.playall { color: #fbbf24; }
.song { display: flex; align-items: center; background: rgba(23,23,23,.75); -webkit-backdrop-filter: blur(24rpx); backdrop-filter: blur(24rpx); border: 1rpx solid rgba(255,255,255,.09); border-radius: 16rpx; padding: 20rpx; margin-bottom: 12rpx; box-shadow: 0 8rpx 28rpx rgba(0,0,0,.35), inset 0 1rpx 0 rgba(255,255,255,.06); }
.meta { flex: 1; min-width: 0; }
.t { color: #fff; font-size: 28rpx; font-weight: bold; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.a { color: #737373; font-size: 24rpx; margin-top: 6rpx; }
.pbtn { width: 72rpx; height: 72rpx; border-radius: 16rpx; background: #262626; color: #a78bfa; display: flex; align-items: center; justify-content: center; margin-left: 16rpx; font-size: 32rpx; }
.pbtn .ic { font-size: 26rpx; }
/* 图标显色：显式颜色（currentColor/inherit 在此环境失效） */
.pbtn .ic-play { border-left-color: #a78bfa; }
.page.light .pbtn { background: #eee; color: #6d28d9; }
.page.light .pbtn .ic-play { border-left-color: #6d28d9; }
.page.purple .pbtn .ic-play { border-left-color: #e9e2ff; }
.page.blue .pbtn .ic-play { border-left-color: #7dd3fc; }
.page.green .pbtn .ic-play { border-left-color: #6ee7b7; }
.pbtn.danger { color: #f87171; }
.sec { color: #fff; font-size: 30rpx; font-weight: bold; margin: 28rpx 0 16rpx; }
.picker { background: rgba(23,23,23,.7); border: 1rpx solid rgba(255,255,255,.1); border-radius: 12rpx; color: #fff; padding: 16rpx; font-size: 28rpx; box-shadow: inset 0 2rpx 8rpx rgba(0,0,0,.4); }
.plrow { display: flex; gap: 24rpx; margin: 16rpx 0; }
.act { color: #a78bfa; font-size: 26rpx; }
.act.play { color: #fbbf24; }
.act.del { color: #f87171; }
.createrow { display: flex; gap: 16rpx; margin-bottom: 16rpx; }
.flex1 { flex: 1; }
.sbtn.sm { min-width: 140rpx; }
.modal { position: fixed; inset: 0; background: rgba(0,0,0,.6); display: flex; align-items: flex-end; z-index: 99; }
.sheet { background: rgba(23,23,23,.9); border-top: 1rpx solid rgba(255,255,255,.1); width: 100%; padding: 32rpx; border-radius: 24rpx 24rpx 0 0; max-height: 70vh; overflow-y: auto; }
.sheet-title { color: #fff; font-size: 32rpx; font-weight: bold; margin-bottom: 16rpx; }
.plpick { color: #e5e5e5; font-size: 30rpx; padding: 24rpx 16rpx; border-bottom: 1rpx solid #262626; }
.page.light { background: radial-gradient(100% 45% at 50% 0%, #ffffff 0%, #edf0f4 55%); }
.page.light .sec-title, .page.light .rowhead { color: #111; }
.page.light .sec { color: #111; }
.page.light .picker { background: rgba(255,255,255,.8); border-color: #ddd; color: #111; box-shadow: inset 0 2rpx 6rpx rgba(0,0,0,.06); }
.page.light .sheet { background: rgba(255,255,255,.92); }
.page.light .sheet-title, .page.light .plpick { color: #111; }
.page.light .plpick { border-color: #eee; }
.page.light .tip { color: #666; }
.page.light .sin { background: rgba(255,255,255,.8); border-color: #ddd; color: #111; box-shadow: inset 0 2rpx 6rpx rgba(0,0,0,.06); }
.page.light .song { background: rgba(255,255,255,.8); border-color: rgba(17,17,17,.07); box-shadow: 0 8rpx 24rpx rgba(0,0,0,.07), inset 0 1rpx 0 rgba(255,255,255,.7); }
.page.light .t { color: #111; }
/* 触摸反馈 */
.song, .pbtn, .sbtn, .playall, .act, .plpick { transition: transform .15s ease, opacity .15s ease, background-color .15s ease; }
.song:active { transform: scale(.98); opacity: .9; }
.act:active, .plpick:active { opacity: .7; }
.pbtn:active, .sbtn:active { transform: scale(.9); opacity: .85; }
/* 紫色 */
.page.purple { background: radial-gradient(100% 45% at 50% 0%, #2a1a48 0%, #150f22 55%); }
.page.purple .sec-title, .page.purple .rowhead { color: #f3efff; }
.page.purple .sec { color: #f3efff; }
.page.purple .picker { background: rgba(33,23,54,.7); border-color: #3a2b5c; color: #f3efff; }
.page.purple .sheet { background: rgba(33,23,54,.92); }
.page.purple .sheet-title, .page.purple .plpick { color: #e9e2ff; }
.page.purple .plpick { border-color: #3a2b5c; }
.page.purple .tip { color: #b7a8d9; }
.page.purple .sin { background: rgba(33,23,54,.7); border-color: #3a2b5c; color: #f3efff; }
.page.purple .song { background: rgba(33,23,54,.75); border-color: rgba(196,181,253,.16); box-shadow: 0 8rpx 28rpx rgba(0,0,0,.35), inset 0 1rpx 0 rgba(196,181,253,.12); }
.page.purple .t { color: #f3efff; }
.page.purple .a { color: #b7a8d9; }
.page.purple .pbtn { background: #3a2b5c; color: #e9e2ff; }
.page.purple .sbtn { background: #7c3aed; }
.page.purple .playall { color: #c4b5fd; }
/* 蓝色 */
.page.blue { background: radial-gradient(100% 45% at 50% 0%, #122c44 0%, #0a141f 55%); }
.page.blue .sec-title, .page.blue .rowhead { color: #eef6ff; }
.page.blue .sec { color: #eef6ff; }
.page.blue .picker { background: rgba(16,32,47,.7); border-color: #1e3a52; color: #eef6ff; }
.page.blue .sheet { background: rgba(16,32,47,.92); }
.page.blue .sheet-title, .page.blue .plpick { color: #dcedff; }
.page.blue .plpick { border-color: #1e3a52; }
.page.blue .tip { color: #93b4cc; }
.page.blue .sin { background: rgba(16,32,47,.7); border-color: #1e3a52; color: #eef6ff; }
.page.blue .song { background: rgba(16,32,47,.75); border-color: rgba(125,211,252,.16); box-shadow: 0 8rpx 28rpx rgba(0,0,0,.35), inset 0 1rpx 0 rgba(125,211,252,.12); }
.page.blue .t { color: #eef6ff; }
.page.blue .a { color: #93b4cc; }
.page.blue .pbtn { background: #1e3a52; color: #7dd3fc; }
.page.blue .sbtn { background: #0284c7; }
.page.blue .playall { color: #7dd3fc; }
/* 绿色 */
.page.green { background: radial-gradient(100% 45% at 50% 0%, #122c20 0%, #0a1512 55%); }
.page.green .sec-title, .page.green .rowhead { color: #effff6; }
.page.green .sec { color: #effff6; }
.page.green .picker { background: rgba(16,36,27,.7); border-color: #1e4d3a; color: #effff6; }
.page.green .sheet { background: rgba(16,36,27,.92); }
.page.green .sheet-title, .page.green .plpick { color: #dcffec; }
.page.green .plpick { border-color: #1e4d3a; }
.page.green .tip { color: #93c4ab; }
.page.green .sin { background: rgba(16,36,27,.7); border-color: #1e4d3a; color: #effff6; }
.page.green .song { background: rgba(16,36,27,.75); border-color: rgba(110,231,183,.16); box-shadow: 0 8rpx 28rpx rgba(0,0,0,.35), inset 0 1rpx 0 rgba(110,231,183,.12); }
.page.green .t { color: #effff6; }
.page.green .a { color: #93c4ab; }
.page.green .pbtn { background: #1e4d3a; color: #6ee7b7; }
.page.green .sbtn { background: #059669; }
.page.green .playall { color: #6ee7b7; }
