<view class="wrap {{theme}}">
  <view class="header">
    <view class="title">{{pickMode ? '选择音箱' : '设备管理'}}</view>
    <view class="avatar-wrap">
      <view class="avatar" bindtap="toggleAvatarMenu">👤</view>
      <view wx:if="{{menuOpen}}" class="menu-mask" bindtap="closeAvatarMenu"></view>
      <view wx:if="{{menuOpen}}" class="menu">
        <view class="menu-item" bindtap="onMenuManage">🔧 设备管理</view>
        <view class="menu-item" bindtap="onMenuTheme">🌗 切换主题</view>
      </view>
    </view>
  </view>
  <view wx:if="{{loading}}" class="tip">加载中…</view>
  <view class="sec">🌐 公网设备</view>
  <view wx:if="{{!loading && list.length === 0}}" class="tip">暂无公网设备</view>
  <view wx:for="{{list}}" wx:key="deviceId" class="card" bindtap="choose" data-id="{{item.deviceId}}">
    <view class="name">{{item.name}}<text class="go"> ›</text></view>
    <view class="tags"><text class="tag">🌐 公网</text><text wx:if="{{activeKind === 'cloud' && activeId === item.deviceId}}" class="tag cur">当前</text></view>
    <view class="did">{{item.deviceId}}</view>
    <view class="row">
      <text>{{showAuth[item.deviceId] ? item.authCode : '••••'}}</text>
      <view class="eye" hover-class="eye-hover" catchtap="toggleEye" data-id="{{item.deviceId}}">{{showAuth[item.deviceId] ? '🙈' : '👁️'}}</view>
    </view>
    <view wx:if="{{!pickMode}}" class="ops">
      <button size="mini" catchtap="openEdit" data-id="{{item.deviceId}}">✏️ 编辑</button>
      <button size="mini" catchtap="remove" data-id="{{item.deviceId}}">🗑️ 删除</button>
    </view>
  </view>
  <button bindtap="openAdd" class="btn">添加公网设备</button>

  <view class="sec">📡 局域网设备（仅存本地）</view>
  <view wx:if="{{lanList.length === 0}}" class="tip">暂无，可手动添加同一 Wi-Fi 下的音箱 IP</view>
  <view wx:for="{{lanList}}" wx:key="deviceId" class="card" bindtap="chooseLan" data-id="{{item.deviceId}}">
    <view class="name">{{item.name}}<text class="go"> ›</text></view>
    <view class="tags"><text class="tag">📡 局域网</text><text wx:if="{{activeKind === 'lan' && activeId === item.deviceId}}" class="tag cur">当前</text></view>
    <view class="did">{{item.deviceId}}</view>
    <view class="ops">
      <button size="mini" catchtap="removeLan" data-id="{{item.deviceId}}">🗑️ 删除</button>
    </view>
  </view>
  <button bindtap="goLanAdd" class="btn">添加局域网设备</button>
  <view wx:if="{{formVisible}}" class="modal" bindtap="closeForm">
      <view class="sheet" catchtap="noop">
        <view class="sheet-title">{{form.isNew ? '添加设备' : '编辑设备'}}</view>
        <view wx:if="{{form.isNew}}" class="notice">⚠️ 请先关注《R1玩转AI》公众号并完成绑定，否则无法添加设备。</view>
      <view class="field">
        <view class="label">deviceId</view>
        <input class="input" placeholder="音箱 deviceId" value="{{form.deviceId}}" disabled="{{!form.isNew}}" data-field="deviceId" bindinput="onFormInput" />
        <view wx:if="{{!form.isNew}}" class="hint">deviceId 创建后不可修改</view>
      </view>
      <view class="field">
        <view class="label">authCode</view>
        <input class="input" placeholder="音箱 authCode" password="{{!showAuth[form.deviceId]}}" value="{{form.authCode}}" data-field="authCode" bindinput="onFormInput" />
      </view>
      <view class="field">
        <view class="label">名称</view>
        <input class="input" placeholder="默认我的音箱" value="{{form.name}}" data-field="name" bindinput="onFormInput" />
      </view>
      <view class="sheet-ops">
        <button class="btn-secondary" bindtap="closeForm">取消</button>
        <button class="btn-primary" type="primary" bindtap="submitForm">保存</button>
      </view>
    </view>
  </view>
  <music-bar theme="{{theme}}" />
</view>
