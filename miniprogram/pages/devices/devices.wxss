.wrap { min-height: 100vh; background: #0a0a0a; padding: 32rpx; padding-bottom: 170rpx; }
.title { color: #fff; font-size: 36rpx; font-weight: bold; margin-bottom: 24rpx; }
.tip { color: #a3a3a3; font-size: 28rpx; }
.header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.header .title { margin-bottom: 0; }
.avatar-wrap { position: relative; }
.avatar { width: 72rpx; height: 72rpx; border-radius: 50%; background: #262626; display: flex; align-items: center; justify-content: center; font-size: 40rpx; }
.menu-mask { position: fixed; inset: 0; background: transparent; z-index: 98; }
.menu { position: absolute; right: 0; top: 88rpx; min-width: 264rpx; background: #1c1c1c; border: 1rpx solid #333; border-radius: 20rpx; padding: 12rpx; z-index: 99; white-space: nowrap; }
.menu-item { color: #e5e5e5; font-size: 28rpx; padding: 20rpx 16rpx; border-radius: 12rpx; }
.card { background: #171717; border: 1rpx solid #262626; border-radius: 24rpx; padding: 24rpx; margin-bottom: 20rpx; }
.name { color: #fff; font-size: 32rpx; font-weight: bold; }
.go { color: #8b5cf6; }
.did { color: #737373; font-size: 24rpx; margin-top: 8rpx; }
.row { display: flex; align-items: center; justify-content: space-between; margin-top: 12rpx; color: #e5e5e5; }
.eye { width: 64rpx; height: 64rpx; border-radius: 50%; background: #262626; display: flex; align-items: center; justify-content: center; font-size: 32rpx; }
.eye-hover { background: #3a3a3a; }
.ops { display: flex; gap: 16rpx; margin-top: 16rpx; }
.ops button { flex: 1; background: #262626; color: #e5e5e5; border-radius: 12rpx; font-size: 28rpx; }
.btn { margin-top: 24rpx; background: #8b5cf6; color: #fff; border-radius: 16rpx; }
.btn::after { border: none; }
.empty { text-align: center; }
.modal { position: fixed; inset: 0; background: rgba(0,0,0,.6); display: flex; align-items: flex-end; }
.sheet { background: #171717; width: 100%; padding: 32rpx; border-radius: 24rpx 24rpx 0 0; }
.sheet-title { color: #fff; font-size: 34rpx; font-weight: bold; margin-bottom: 8rpx; }
.field { margin-top: 20rpx; }
.label { color: #a3a3a3; font-size: 26rpx; margin-bottom: 8rpx; }
.input { background: #0a0a0a; color: #fff; border: 1rpx solid #333; border-radius: 12rpx; padding: 16rpx; }
.hint { color: #737373; font-size: 24rpx; margin-top: 8rpx; }
.sheet-ops { display: flex; gap: 16rpx; margin-top: 28rpx; }
.sheet-ops button { flex: 1; border-radius: 16rpx; font-size: 30rpx; line-height: 88rpx; }
.sheet-ops button::after { border: none; }
.btn-secondary { background: #262626; color: #e5e5e5; }
.btn-primary { background: #8b5cf6; color: #fff; }
/* 浅色主题覆盖 */
.wrap.light { background: #f5f5f5; }
.wrap.light .title, .wrap.light .name, .wrap.light .sheet-title { color: #111; }
.wrap.light .tip, .wrap.light .label { color: #666; }
.wrap.light .did, .wrap.light .hint { color: #999; }
.wrap.light .card, .wrap.light .sheet { background: #fff; border-color: #e5e5e5; }
.wrap.light .row { color: #333; }
.wrap.light .ops button, .wrap.light .btn-secondary, .wrap.light .eye { background: #eee; color: #333; }
.wrap.light .input { background: #f5f5f5; color: #111; border-color: #ddd; }
.wrap.light .avatar { background: #e5e5e5; }
.wrap.light .menu { background: #fff; border-color: #e5e5e5; }
.wrap.light .menu-item { color: #333; }
/* 紫色主题 */
.wrap.purple { background: #150f22; }
.wrap.purple .title, .wrap.purple .name, .wrap.purple .sheet-title { color: #f3efff; }
.wrap.purple .tip, .wrap.purple .label { color: #b7a8d9; }
.wrap.purple .did, .wrap.purple .hint { color: #8d7bb5; }
.wrap.purple .card, .wrap.purple .sheet { background: #211736; border-color: #3a2b5c; }
.wrap.purple .row { color: #e9e2ff; }
.wrap.purple .ops button, .wrap.purple .btn-secondary, .wrap.purple .eye { background: #3a2b5c; color: #e9e2ff; }
.wrap.purple .input { background: #150f22; color: #f3efff; border-color: #3a2b5c; }
.wrap.purple .avatar { background: #3a2b5c; }
.wrap.purple .menu { background: #1e1430; border-color: #3a2b5c; }
.wrap.purple .menu-item { color: #e9e2ff; }
/* 蓝色主题 */
.wrap.blue { background: #0a141f; }
.wrap.blue .title, .wrap.blue .name, .wrap.blue .sheet-title { color: #eef6ff; }
.wrap.blue .tip, .wrap.blue .label { color: #93b4cc; }
.wrap.blue .did, .wrap.blue .hint { color: #6b8ba3; }
.wrap.blue .card, .wrap.blue .sheet { background: #10202f; border-color: #1e3a52; }
.wrap.blue .row { color: #dcedff; }
.wrap.blue .ops button, .wrap.blue .btn-secondary, .wrap.blue .eye { background: #1e3a52; color: #dcedff; }
.wrap.blue .btn-primary, .wrap.blue .btn { background: #0284c7; }
.wrap.blue .input { background: #0a141f; color: #eef6ff; border-color: #1e3a52; }
.wrap.blue .avatar { background: #1e3a52; }
.wrap.blue .menu { background: #0f1f30; border-color: #1e3a52; }
.wrap.blue .menu-item { color: #dcedff; }
/* 绿色主题 */
.wrap.green { background: #0a1512; }
.wrap.green .title, .wrap.green .name, .wrap.green .sheet-title { color: #effff6; }
.wrap.green .tip, .wrap.green .label { color: #93c4ab; }
.wrap.green .did, .wrap.green .hint { color: #6f9c86; }
.wrap.green .card, .wrap.green .sheet { background: #10241b; border-color: #1e4d3a; }
.wrap.green .row { color: #dcffec; }
.wrap.green .ops button, .wrap.green .btn-secondary, .wrap.green .eye { background: #1e4d3a; color: #dcffec; }
.wrap.green .btn-primary, .wrap.green .btn { background: #059669; }
.wrap.green .input { background: #0a1512; color: #effff6; border-color: #1e4d3a; }
.wrap.green .avatar { background: #1e4d3a; }
.wrap.green .menu { background: #0e2118; border-color: #1e4d3a; }
.wrap.green .menu-item { color: #dcffec; }
