.page { min-height: 100vh; background: radial-gradient(100% 45% at 50% 0%, #161618 0%, #0a0a0a 55%); padding: 32rpx; padding-bottom: 170rpx; }
.sec-title { color: #fff; font-size: 38rpx; font-weight: 900; margin-bottom: 8rpx; }
.tip { color: #737373; font-size: 26rpx; margin-bottom: 16rpx; }
.switchrow { display: flex; justify-content: space-between; align-items: center; background: rgba(23,23,23,.75); -webkit-backdrop-filter: blur(24rpx); backdrop-filter: blur(24rpx); border: 1rpx solid rgba(255,255,255,.09); border-radius: 16rpx; padding: 20rpx 24rpx; color: #e5e5e5; font-size: 28rpx; margin-bottom: 8rpx; box-shadow: 0 8rpx 28rpx rgba(0,0,0,.35), inset 0 1rpx 0 rgba(255,255,255,.06); }
.lb { color: #a3a3a3; font-size: 24rpx; margin: 16rpx 0 8rpx; }
.in { background: rgba(23,23,23,.7); border: 1rpx solid rgba(255,255,255,.1); border-radius: 12rpx; color: #fff; padding: 0 16rpx; height: 88rpx; line-height: 88rpx; font-size: 28rpx; box-sizing: border-box; box-shadow: inset 0 2rpx 8rpx rgba(0,0,0,.4); }
.ta { background: rgba(23,23,23,.7); border: 1rpx solid rgba(255,255,255,.1); border-radius: 12rpx; color: #fff; padding: 16rpx; font-size: 28rpx; width: 100%; box-sizing: border-box; box-shadow: inset 0 2rpx 8rpx rgba(0,0,0,.4); }
.btn { background: linear-gradient(135deg, #8b5cf6, #7c3aed); color: #fff; border-radius: 16rpx; margin-top: 24rpx; font-size: 30rpx; box-shadow: 0 8rpx 24rpx rgba(139,92,246,.35), inset 0 1rpx 0 rgba(255,255,255,.25); }
.btn.ghost { background: rgba(255,255,255,.06); border: 1rpx solid rgba(255,255,255,.2); box-shadow: none; }
.btn[disabled] { opacity: .45; }
.verify-msg { color: #f87171; font-size: 26rpx; margin-top: 12rpx; }
.verify-msg.ok { color: #34d399; }
.page.light { background: radial-gradient(100% 45% at 50% 0%, #ffffff 0%, #edf0f4 55%); }
.page.light .sec-title { color: #111; }
.page.light .tip, .page.light .lb { color: #666; }
.page.light .switchrow { background: rgba(255,255,255,.8); border-color: rgba(17,17,17,.07); color: #333; box-shadow: 0 8rpx 24rpx rgba(0,0,0,.07), inset 0 1rpx 0 rgba(255,255,255,.7); }
.page.light .in, .page.light .ta { background: rgba(255,255,255,.8); border-color: #ddd; color: #111; box-shadow: inset 0 2rpx 6rpx rgba(0,0,0,.06); }
.page.light .btn.ghost { background: rgba(0,0,0,.04); border-color: #ccc; color: #333; }
/* 触摸反馈 */
.switchrow, .btn { transition: transform .15s ease, opacity .15s ease, background-color .15s ease; }
.btn:active { transform: scale(.97); opacity: .9; filter: brightness(1.08); }
/* 紫色 */
.page.purple { background: radial-gradient(100% 45% at 50% 0%, #2a1a48 0%, #150f22 55%); }
.page.purple .sec-title { color: #f3efff; }
.page.purple .tip, .page.purple .lb { color: #b7a8d9; }
.page.purple .switchrow { background: rgba(33,23,54,.75); border-color: rgba(196,181,253,.16); color: #e9e2ff; box-shadow: 0 8rpx 28rpx rgba(0,0,0,.35), inset 0 1rpx 0 rgba(196,181,253,.12); }
.page.purple .in, .page.purple .ta { background: rgba(33,23,54,.7); border-color: #3a2b5c; color: #f3efff; }
.page.purple .btn { background: linear-gradient(135deg, #8b5cf6, #7c3aed); box-shadow: 0 8rpx 24rpx rgba(139,92,246,.35), inset 0 1rpx 0 rgba(255,255,255,.25); }
/* 蓝色 */
.page.blue { background: radial-gradient(100% 45% at 50% 0%, #122c44 0%, #0a141f 55%); }
.page.blue .sec-title { color: #eef6ff; }
.page.blue .tip, .page.blue .lb { color: #93b4cc; }
.page.blue .switchrow { background: rgba(16,32,47,.75); border-color: rgba(125,211,252,.16); color: #dcedff; box-shadow: 0 8rpx 28rpx rgba(0,0,0,.35), inset 0 1rpx 0 rgba(125,211,252,.12); }
.page.blue .in, .page.blue .ta { background: rgba(16,32,47,.7); border-color: #1e3a52; color: #eef6ff; }
.page.blue .btn { background: linear-gradient(135deg, #38bdf8, #0284c7); box-shadow: 0 8rpx 24rpx rgba(2,132,199,.35), inset 0 1rpx 0 rgba(255,255,255,.25); }
/* 绿色 */
.page.green { background: radial-gradient(100% 45% at 50% 0%, #122c20 0%, #0a1512 55%); }
.page.green .sec-title { color: #effff6; }
.page.green .tip, .page.green .lb { color: #93c4ab; }
.page.green .switchrow { background: rgba(16,36,27,.75); border-color: rgba(110,231,183,.16); color: #dcffec; box-shadow: 0 8rpx 28rpx rgba(0,0,0,.35), inset 0 1rpx 0 rgba(110,231,183,.12); }
.page.green .in, .page.green .ta { background: rgba(16,36,27,.7); border-color: #1e4d3a; color: #effff6; }
.page.green .btn { background: linear-gradient(135deg, #34d399, #059669); box-shadow: 0 8rpx 24rpx rgba(5,150,105,.35), inset 0 1rpx 0 rgba(255,255,255,.25); }
